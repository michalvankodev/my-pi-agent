# Sensitive credentials - NEVER commit
agent/auth.json
web-search.json

# Transient session data (per-project, auto-generated, can be large)
agent/sessions/

# Subagent mission records (local project paths, prompt-derived content)
agent/missions/

# Extension message inboxes (transient, auto-generated)
agent/powerline-footer/

# Debug logs
agent/*-debug.log
agent/*-crash.log

# Managed binaries (fd, rg, etc.) - can be reinstalled
agent/bin/

# Git-installed packages (pi install git:...) - can be reinstalled
agent/git/

# NPM-installed packages (project-local) - can be reinstalled
agent/npm/

# Extension backup files
agent/extensions/*.v*.json

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~

# Tau instances (runtime instance tracking)
tau-instances/

# Session history
history/

# Pompom folder
pompom/

# Team session management (pi-teams extension)
teams/
agent/telegram.json
agent/locks.json

# Telegram temp files (locks, attachments)
agent/tmp/
agent/trust.json
agent/litellm-models.json
.pi-subagents
agent/run-history.jsonl
agent/mcp-cache.json
agent/mcp-npx-cache.json
